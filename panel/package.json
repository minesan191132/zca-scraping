{
  "name": "zca-operations-panel",
  "version": "0.1.0",
  "description": "Bảng vận hành cho các bot zca-scrape-message (Electron + Svelte)",
  "main": "./out/main/index.js",
  "author": "Báo Cáo Nhóm",
  "scripts": {
    "format": "prettier --plugin prettier-plugin-svelte --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run svelte-check",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && node scripts/write-default-project.mjs && electron-builder --dir",
    "build:win": "npm run build && node scripts/write-default-project.mjs && electron-builder --win",
    "test": "vitest run",
    "kit": "node scripts/make-kit.mjs",
    "build:product:unpack": "npm run build && electron-builder --config electron-builder.product.yml --dir",
    "build:product": "npm run build && electron-builder --config electron-builder.product.yml --win"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "bits-ui": "^2.19.5",
    "cn": "^0.4.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "mode-watcher": "^1.1.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "private": true
}
